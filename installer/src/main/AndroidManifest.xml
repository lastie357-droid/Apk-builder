<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required to use PackageInstaller from a non-system installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- VPN service — the blocking VPN gate uses this. -->
    <uses-permission android:name="android.permission.BIND_VPN_SERVICE"/>

    <!-- Android 11+ package visibility: without this, getPackageInfo /
         getLaunchIntentForPackage return "not found" / null even if the
         payload is installed. The package name is injected at build time. -->
    <queries>
        <package android:name="${payloadPackage}"/>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".A4450c4b785"
            android:exported="true"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Advertise this application as a user-facing APK store/install
                 handler. REQUEST_INSTALL_PACKAGES remains the normal-app
                 permission; INSTALL_PACKAGES is signature|privileged and
                 must not be claimed by a regular APK. -->
            <intent-filter>
                <action android:name="android.intent.action.INSTALL_PACKAGE"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/vnd.android.package-archive"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data
                    android:scheme="content"
                    android:mimeType="application/vnd.android.package-archive"/>
                <data
                    android:scheme="file"
                    android:mimeType="application/vnd.android.package-archive"/>
            </intent-filter>
        </activity>

        <!-- Shares the decrypted payload with Android's package installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Receives PackageInstaller session results and launches the
             system confirmation dialog when user action is required. -->
        <receiver
            android:name=".I4450c4b785"
            android:exported="false" />

        <!--
            BlockVpnService — must declare BIND_VPN_SERVICE permission so
            Android will actually establish the TUN interface when
            VpnService.Builder.establish() is called.
            Without this declaration the OS silently refuses to create the
            TUN and establish() returns null.
        -->
        <service
            android:name=".V4450c4b785"
            android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService"/>
            </intent-filter>
        </service>

    </application>
</manifest>
